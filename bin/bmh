#!/usr/bin/env nix-shell
#!nix-shell -i bash -p bash jq

set -euo pipefail

VERSION="1.0.1"

# Resolve symlink to locate the real BMH_DIR
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
BMH_DIR="$( cd -P "$( dirname "$SOURCE" )/.." && pwd )"

# Load UI library
# shellcheck source=/dev/null
source "$BMH_DIR/lib/ui.sh"

# -----------------------------------------------------------------------------
# Help & Version Information
# -----------------------------------------------------------------------------
show_help() {
  cat <<EOF
bmh - Basic Memory Helper (v${VERSION})

Usage:
  bmh                     Launch the interactive Basic Memory session
  bmh update              Pull and apply the latest updates from GitHub
  <command> | bmh         Format piped JSON output as cards

Description:
  bmh is a purely interactive companion for Basic Memory (bm).
  It guides you through searching notes, discovering active tasks,
  and browsing projects, then renders every note in clean, structured cards.

EOF
}

show_version() {
  echo "bmh version ${VERSION}"
}

# -----------------------------------------------------------------------------
# Self-Update Function
# -----------------------------------------------------------------------------
update_bmh() {
  echo -e "\n${BOLD}${CYAN}── 🔄 Updating bmh ──${RESET}" >&2
  if [[ ! -d "$BMH_DIR/.git" ]]; then
    echo -e "${YELLOW}Warning: $BMH_DIR is not a git repository. Cannot update automatically.${RESET}" >&2
    return 1
  fi

  echo -e "${DIM}Pulling latest changes from origin main...${RESET}" >&2
  if git -C "$BMH_DIR" pull --ff-only; then
    echo -e "\n${GREEN}✨ bmh is now up to date!${RESET}\n" >&2
  else
    echo -e "\n${YELLOW}Could not update cleanly. Please inspect git status in $BMH_DIR.${RESET}\n" >&2
  fi
}

# -----------------------------------------------------------------------------
# Core Search Runner
# -----------------------------------------------------------------------------
execute_bm_search() {
  local query="${1:-}"
  local project="${2:-}"
  local note_type="${3:-}"
  local status="${4:-}"
  local is_title="${5:-false}"

  local bm_args=()

  if [[ "$is_title" == "true" ]]; then
    bm_args+=(--title)
  fi

  if [[ -n "$query" ]]; then
    bm_args+=("$query")
  fi

  if [[ -n "$project" ]]; then
    bm_args+=(--project "$project")
  fi

  if [[ -n "$note_type" ]]; then
    bm_args+=(--type "$note_type")
  fi

  if [[ -n "$status" ]]; then
    bm_args+=(--status "$status")
  fi

  bm_args+=(--json)

  echo -e "\n${CYAN}Searching Basic Memory...${RESET}\n" >&2
  local output
  output=$(bm tool search-notes "${bm_args[@]}")

  render_cards "$output"
}

# -----------------------------------------------------------------------------
# Interactive Flows
# -----------------------------------------------------------------------------
flow_search_notes() {
  echo -e "\n${BOLD}${CYAN}── 🔍 Search Notes ──${RESET}" >&2
  read -rp "Enter search query (or press Enter for all): " query < /dev/tty

  local is_title=false
  if [[ -n "$query" ]]; then
    read -rp "Search in title only? (y/N) [n]: " title_only < /dev/tty
    [[ "$title_only" =~ ^[Yy] ]] && is_title=true
  fi

  read -rp "Project filter ('kancil', 'kensho', or leave empty for all) []: " project < /dev/tty

  execute_bm_search "$query" "$project" "" "" "$is_title"
}

flow_active_tasks() {
  echo -e "\n${BOLD}${YELLOW}── ⚡ Active Tasks ──${RESET}" >&2
  read -rp "Project filter ('kancil', 'kensho', or leave empty for all) []: " project < /dev/tty

  execute_bm_search "" "$project" "task" "active" false
}

flow_browse_project() {
  echo -e "\n${BOLD}${BLUE}── 📚 Browse by Project ──${RESET}" >&2
  echo -e "  [1] kancil ${DIM}(operational life & agent tasks)${RESET}" >&2
  echo -e "  [2] kensho ${DIM}(durable knowledge base)${RESET}" >&2
  read -rp "Select project [1]: " proj_choice < /dev/tty

  local project="kancil"
  if [[ "$proj_choice" == "2" || "$proj_choice" == "kensho" ]]; then
    project="kensho"
  fi

  read -rp "Search query within $project (optional): " query < /dev/tty
  execute_bm_search "$query" "$project" "" "" false
}

flow_recent_notes() {
  echo -e "\n${BOLD}${MAGENTA}── 🕒 Recent Notes ──${RESET}" >&2
  read -rp "Project filter ('kancil', 'kensho', or leave empty for all) []: " project < /dev/tty
  execute_bm_search "" "$project" "" "" false
}

# -----------------------------------------------------------------------------
# Main Interactive Loop
# -----------------------------------------------------------------------------
main_session() {
  render_banner

  while true; do
    echo -e "\n${BOLD}What would you like to do?${RESET}" >&2
    echo -e "  [1] 🔍 Search notes ${DIM}(by title or content)${RESET}" >&2
    echo -e "  [2] ⚡ View active tasks ${DIM}(current commitments)${RESET}" >&2
    echo -e "  [3] 📚 Browse by project ${DIM}(kancil / kensho)${RESET}" >&2
    echo -e "  [4] 🕒 View recent notes" >&2
    echo -e "  [5] 🔄 Update bmh ${DIM}(pull latest from GitHub)${RESET}" >&2
    echo -e "  [0] 🚪 Exit" >&2
    echo -e "──────────────────────────────────────────────" >&2

    read -rp "Select an option [1]: " choice < /dev/tty
    choice="${choice:-1}"

    case "$choice" in
      1|search)
        flow_search_notes
        ;;
      2|tasks|task)
        flow_active_tasks
        ;;
      3|project)
        flow_browse_project
        ;;
      4|recent)
        flow_recent_notes
        ;;
      5|update)
        update_bmh
        ;;
      0|q|quit|exit)
        echo -e "\n${DIM}Goodbye!${RESET}\n" >&2
        break
        ;;
      *)
        echo -e "${YELLOW}Invalid option '$choice'. Please select from the menu.${RESET}" >&2
        ;;
    esac

    echo -e "\n${DIM}──────────────────────────────────────────────${RESET}" >&2
    read -rp "Press Enter to return to main menu (or 'q' to quit): " cont < /dev/tty
    if [[ "$cont" =~ ^[Qq] ]]; then
      echo -e "\n${DIM}Goodbye!${RESET}\n" >&2
      break
    fi
  done
}

# -----------------------------------------------------------------------------
# Entrypoint
# -----------------------------------------------------------------------------
if [[ $# -gt 0 ]]; then
  case "$1" in
    update|upgrade|--update)
      update_bmh
      exit 0
      ;;
    -h|--help)
      show_help
      exit 0
      ;;
    -v|--version)
      show_version
      exit 0
      ;;
    *)
      show_help
      exit 0
      ;;
  esac
fi

if [[ ! -t 0 ]]; then
  # Piped input: format json stream directly as cards
  input_data=$(cat)
  render_cards "$input_data"
else
  main_session
fi
